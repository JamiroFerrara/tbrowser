{
  "name": "tbrowser",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Chromium browser: one page, one command bar, real Chrome extensions.",
  "main": "main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "add-ext": "node scripts/install-extension.mjs",
    "pack:win": "node scripts/fetch-koffi-win.mjs && electron-packager . tbrowser --platform=win32 --arch=x64 --out=dist --overwrite --asar.unpackDir=vendor --asar.unpack=\"**/*.node\" --ignore=\"^/test\" --ignore=\"^/dist\" --ignore=\"^/\\.git\""
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^45.0.0",
    "fflate": "^0.8.2"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "koffi": "^3.3.7"
  },
  "optionalDependencies": {
    "@koromix/koffi-win32-x64": "^3.3.7"
  }
}
